# H-Staff backend environment template. Copy to server/.env and fill real secrets.
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
# Local-only OTP display. Set false when configuring Twilio or in production.
DEV_OTP_ENABLED=true
OTP_TTL_SECONDS=300
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
# Generate unique random values for production.
JWT_SECRET=
QR_SECRET=
GOOGLE_CLIENT_ID=
# Use LIVE credentials only (Key ID starts with rzp_live_). Keep secrets server-side.
RAZORPAY_KEY_ID=rzp_live_REPLACE_WITH_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_YOUR_LIVE_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_YOUR_WEBHOOK_SECRET
DEMO_MODE=false
REQUIRE_KYC_TO_APPLY=true
ENFORCE_TIME_WINDOW=true
TZ_OFFSET_MINUTES=330

# Optional SMTP for KYC status e-mails (logged to console when unset). Requires `npm i nodemailer`.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=compliance@hstaff.com
